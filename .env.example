# --- Mercado Pago (assinaturas em reais) ---
# Access Token de PRODUCAO (comeca com APP_USR-). Nunca commitar, nunca expor no navegador.
MERCADOPAGO_ACCESS_TOKEN=
# Chave secreta do webhook (Suas integracoes > Webhooks > Configurar notificacoes > Chave secreta).
MERCADOPAGO_WEBHOOK_SECRET=

# --- Stripe (assinaturas em dolar) ---
# Use a private key beginning with sk_test_ or sk_live_; never use pk_test_ here.
STRIPE_SECRET_KEY=
# Set this to the endpoint signing secret beginning with whsec_.
STRIPE_WEBHOOK_SECRET=

# URL publica da aplicacao (HTTPS em producao; o Mercado Pago usa para back_url e webhook).
NUXT_PUBLIC_APP_URL=http://localhost:3000

# --- Preços e moeda ---
# Livro de preços: seguro (padrão, para S3 Standard) ou competitivo (só após migrar para R2/B2).
NUXT_PUBLIC_PRICE_BOOK=seguro
# Habilita EUR para países da zona do euro (configure o IVA no Stripe antes).
NUXT_PUBLIC_ENABLE_EUR=false

# --- Dados legais (páginas Termos, Privacidade, Reembolso e rodapé) ---
NUXT_PUBLIC_COMPANY_NAME=
NUXT_PUBLIC_COMPANY_CNPJ=
NUXT_PUBLIC_COMPANY_ADDRESS=
NUXT_PUBLIC_SUPPORT_EMAIL=
NUXT_PUBLIC_DPO_EMAIL=
# Deixe true até a revisão jurídica; depois false.
NUXT_PUBLIC_LEGAL_DRAFT=true

# --- Lixeira: segredo da tarefa diária de limpeza (vercel.json). Gere um texto longo e aleatório. ---
CRON_SECRET=

# --- Downloads do app de backup (padrão: releases do GitHub) ---
# NUXT_PUBLIC_DESKTOP_DOWNLOAD_BASE=https://github.com/AnthonyBuilder/Cloud-Seller/releases/latest/download
# NUXT_PUBLIC_DESKTOP_RELEASES_URL=https://github.com/AnthonyBuilder/Cloud-Seller/releases/latest
