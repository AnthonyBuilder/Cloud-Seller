{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ListarLixeira",
      "Effect": "Allow",
      "Action": "s3:ListBucket",
      "Resource": "arn:aws:s3:::SEU-BUCKET",
      "Condition": { "StringLike": { "s3:prefix": ["trash/*"] } }
    },
    {
      "Sid": "ObjetosDaLixeira",
      "Effect": "Allow",
      "Action": ["s3:GetObject", "s3:PutObject", "s3:DeleteObject"],
      "Resource": "arn:aws:s3:::SEU-BUCKET/trash/*"
    }
  ]
}
